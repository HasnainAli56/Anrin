.button--blue:hover,.gform_button:hover,.floating-cta:hover,..has-blue-background-color:hover,.wp-block-file__button:hover,.wp-block-button__link:hover{background-color:#2e2e2e!important;color:#FFFFFF!important;}

.has-blue-color,.has-inline-color{color:#000000!important}

.sidebar{background-color:transparent}

.sidebar__item--current .sidebar__link:after {background-color: #929292}

.sidebar__link {margin: 4px 4px;color: #000;background-color: #FFFFFF;border-top: 0 none;box-shadow: 1px 1px 7px -2px rgb(0 0 0 / 30%);-webkit-box-shadow: 1px 1px 7px -2px rgb(0 0 0 / 30%);-moz-box-shadow: 1px 1px 7px -2px rgba(0,0,0,.3)}

.sidebar__link--current, .sidebar__link:hover {background-color: #f1f1f1}

.sidebar__link--current:after, .sidebar__link:hover:after {background-color: #000000 !important}

.gform_body .gform_fields .gfield .ginput_container input,.gform_body .gform_fields .gfield .ginput_container textarea{border:2px solid #000000;border-radius:0}

.wp-container-9.wp-block-columns.alignfull.has-background h3,.wp-container-9.wp-block-columns.alignfull.has-background .has-black-color,.wp-container-1.wp-block-columns.alignfull.has-background h3,.wp-container-1.wp-block-columns.alignfull.has-background .has-black-color {color:#FFF!important}
