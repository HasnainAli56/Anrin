.has-blue-background-color,.wp-block-separator.has-blue-background-color:after,.wp-block-separator.has-blue-background-color:before,.wp-block-file__button,.wp-block-button__link{background-color:#000000!important;color:#FFFFFF!important;}
.has-blue-gray-background-color,.wp-block-separator.has-blue-gray-background-color:after,.wp-block-separator.has-blue-gray-background-color:before,.floating-cta{background-color:#000000!important;color:#FFFFFF!important;border-radius:0!important}
.has-blue-gray-background-color.has-black-color{color:#FFFFFF!important;}
