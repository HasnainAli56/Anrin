.footer .custom-logo-link {display: inline-block;width: 100%;margin-top: -4rem;padding: 0 6rem}

.footer__link {margin-top: 0;padding: 0;background-color: transparent;color: #fff !important;border-radius: 0}
.footer__link:hover {color: #f1f1f1 !important;background-color: transparent;-webkit-box-shadow: none !important;box-shadow: none !important}

